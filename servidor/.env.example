# Copia este archivo como .env y completa los valores.
# NO subas el archivo .env real a git.

# Puerto de la API
PORT=3000

# Secreto para firmar los tokens JWT.
# Genera uno nuevo con:
# node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=

# Conexion a PostgreSQL
DB_USER=postgres
DB_PASSWORD=
DB_HOST=localhost
DB_NAME=tienda_ropa
DB_PORT=5432
